----------------------------------------------------
-- ESP
----------------------------------------------------
local espEnabled = false
createToggle("Player ESP", 180, function(state)
	espEnabled = state
	if not espEnabled then
		for _, plr in pairs(Players:GetPlayers()) do
			if plr.Character and plr.Character:FindFirstChild("ESP_Highlight") then
				plr.Character.ESP_Highlight:Destroy()
			end
			if plr.Character and plr.Character:FindFirstChild("ESP_Billboard") then
				plr.Character.ESP_Billboard:Destroy()
			end
		end
	end
end)

local function addESP(plr)
	if plr == player then return end
	plr.CharacterAdded:Connect(function(char)
		char:WaitForChild("Humanoid")

		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Highlight"
		highlight.FillTransparency = 1
		highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
		highlight.OutlineTransparency = 0
		highlight.Parent = char

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ESP_Billboard"
		billboard.Adornee = char:WaitForChild("HumanoidRootPart")
		billboard.Size = UDim2.new(0, 200, 0, 50)
		billboard.AlwaysOnTop = true
		billboard.Parent = char

		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = UDim2.new(1, 0, 1, 0)
		text.TextColor3 = Color3.new(1, 0, 0)
		text.TextStrokeTransparency = 0
		text.Font = Enum.Font.GothamBold
		text.TextScaled = true
		text.Parent = billboard

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		RunService.RenderStepped:Connect(function()
			if espEnabled and humanoid then
				text.Text = string.format("%s | %d HP", plr.DisplayName, math.floor(humanoid.Health))
			else
				text.Text = ""
			end
		end)
	end)
end

for _, plr in pairs(Players:GetPlayers()) do
	addESP(plr)
end

Players.PlayerAdded:Connect(addESP)
